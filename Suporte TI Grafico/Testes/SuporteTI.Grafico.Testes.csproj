<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Desempenho/**/*.cs" />
    <Compile Include="../CatalogoFerramentas.cs" Link="CatalogoFerramentas.cs" />
    <Compile Include="../FluxoFerramentas.cs" Link="FluxoFerramentas.cs" />
    <Compile Include="../ResumoDiscos.cs" Link="ResumoDiscos.cs" />
    <Compile Include="../ConsultaPowerShell.cs" Link="ConsultaPowerShell.cs" />
    <Compile Include="../ArvoreConsulta.cs" Link="ArvoreConsulta.cs" />
    <Compile Include="../LinhasResultado.cs" Link="LinhasResultado.cs" />
    <Compile Include="../ElevacaoConsulta.cs" Link="ElevacaoConsulta.cs" />
    <EmbeddedResource Include="../Modulos/Administrativo.ps1" LogicalName="Elevacao.Administrativo" />
    <Compile Include="../LogConsulta.cs" Link="LogConsulta.cs" />
    <Compile Include="../MonitorRecursos.cs" Link="MonitorRecursos.cs" />
    <Compile Include="../VarreduraDisco.cs" Link="VarreduraDisco.cs" />
    <None Include="../Modulos/*.ps1" Link="Modulos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Modulos/Rede.ps1;../../Modulos/Falhas.ps1;../../Modulos/Discos.ps1;../../Modulos/CatalogoFalhas.json;../../Recursos/SuporteTI.Windows.dll" Link="Modulos/Coletores/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Ferramentas/smartmontools/bin/smartctl.exe;../../Ferramentas/smartmontools/bin/drivedb.h" Link="Modulos/Ferramentas/smartmontools/bin/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Ferramentas/smartmontools/integridade.json" Link="Modulos/Ferramentas/smartmontools/integridade.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
